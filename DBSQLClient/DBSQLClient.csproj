<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>DBSQLClient</PackageId>
    <Version>1.0.0</Version>
    <Authors>Erick Rashon</Authors>
    <Description>Cliente ligero sobre Microsoft.Data.SqlClient para ejecutar queries y procedimientos almacenados en SQL Server, con mapeo automático a objetos, builder de parámetros (SqlParams) y manejo simplificado de parámetros de salida.</Description>
    <PackageTags>sql;sqlserver;sqlclient;ado.net;mssql;orm-lite;dapper-alternative</PackageTags>
    <PackageProjectUrl>https://github.com/yetto-tools/SQLClientService</PackageProjectUrl>
    <RepositoryUrl>https://github.com/yetto-tools/SQLClientService</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Servicio\Mapper\Relations\**" />
    <EmbeddedResource Remove="Servicio\Mapper\Relations\**" />
    <None Remove="Servicio\Mapper\Relations\**" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.3" />
  </ItemGroup>

</Project>
